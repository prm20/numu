  "writing_system": {
    "vowels": ["a", "e", "i", "o", "u"],
    "letters_not_used": ["f", "j", "l", "q", "r", "v", "x"],
    "vowel_sounds": [
      { "letter": "a", "sound_description": "like the 'a' in father", "examples": [{ "paiute": "Ada", "english": "crow" }, { "paiute": "Haga", "english": "who" }] },
      { "letter": "e", "sound_description": "like the 'e' in easy", "examples": [{ "paiute": "Ehobe", "english": "dove" }, { "paiute": "Hebe", "english": "drink" }] },
      { "letter": "i", "sound_description": "like the 'i' in high", "examples": [{ "paiute": "Kiba", "english": "mountain" }, { "paiute": "Hitse", "english": "sweetheart" }] },
      { "letter": "o", "sound_description": "like the 'o' in no", "examples": [{ "paiute": "Nobe", "english": "house" }, { "paiute": "Soba", "english": "cheeks" }] },
      { "letter": "u", "sound_description": "like the 'u' in put", "examples": [{ "paiute": "Numu", "english": "people" }, { "paiute": "Padu", "english": "daughter" }, { "paiute": "nu", "english": "I" }] }
    ],
    "elongated_sounds": {
      "description": "Doubled letters indicate sounds held longer: aa, ee, mm, nn",
      "examples": [
        { "paiute": "Aa", "english": "antlers" },
        { "paiute": "Teepu", "english": "earth, land" },
        { "paiute": "Tommo", "english": "winter" },
        { "paiute": "Tsahanne", "english": "undo" }
      ]
    },
    "vowel_combinations": [
      { "combo": "oo", "sound_description": "like the 'oo' in boot", "examples": [{ "paiute": "Pookoo", "english": "horse" }, { "paiute": "Kootsoo", "english": "cow" }] },
      { "combo": "ae", "sound_description": "like the 'a' in say", "examples": [{ "paiute": "Sae", "english": "thigh" }, { "paiute": "Tumadaena", "english": "right" }] },
      { "combo": "ow", "sound_description": "like the 'ow' in cow", "examples": [{ "paiute": "Kowpa", "english": "leg" }, { "paiute": "Powma", "english": "rain" }] },
      { "combo": "oe", "sound_description": "like the 'oy' ending in toy", "examples": [{ "paiute": "Toe", "english": "cattail" }, { "paiute": "Nakoe", "english": "fight" }] },
      { "combo": "ea", "sound_description": "special sound unlike in English", "examples": [{ "paiute": "Pea", "english": "mother" }, { "paiute": "Mea", "english": "go" }] },
      { "combo": "dy", "sound_description": "the 'ch' sound in English", "examples": [{ "paiute": "Tuhudya", "english": "deer" }, { "paiute": "Kodyu", "english": "return" }] }
    ],
    "glottal_stop": {
      "symbol": "'",
      "description": "Apostrophe marks a split-second interruption of breath and sound. Voiceless glottal.",
      "examples": [
        { "paiute": "Pabe'e", "english": "older brother" },
        { "paiute": "Mogo'ne", "english": "lady" },
        { "paiute": "Saa'a", "english": "later" },
        { "paiute": "Hi'e", "english": "uncle" }
      ]
    },
    "consonants": [
      { "letter": "b", "sound_description": "identical to English 'b' as in 'Bill'" },
      { "letter": "c", "sound_description": "s sound, only used in few words", "examples": [{ "paiute": "Cee", "english": "intestines" }, { "paiute": "Nocee", "english": "dream" }] },
      { "letter": "d", "sound_description": "identical to English 'd' as in 'dog'" },
      { "letter": "g", "sound_description": "identical to English 'g' as in 'great'" },
      { "letter": "h", "sound_description": "identical to English 'h' as in 'hill'" },
      { "letter": "k", "sound_description": "like the English 'k' as in 'kid'" },
      { "letter": "m", "sound_description": "identical to English 'm' as in 'mother'" },
      { "letter": "n", "sound_description": "identical to English 'n' as in 'need'" },
      { "letter": "p", "sound_description": "identical to English 'p' as in 'proud'" },
      { "letter": "s", "sound_description": "either like English 's' (as in silly) or like English 'sh' (as in shop). If next to 'e' or 'i', sounds like 'sh'", "examples": [{ "paiute": "Pesa", "english": "good" }, { "paiute": "Esa", "english": "wolf" }] },
      { "letter": "t", "sound_description": "identical to English 't' as in 'tall'" },
      { "letter": "w", "sound_description": "like 'w' in 'Will' but softer, between 'm' and 'w'" },
      { "letter": "y", "sound_description": "identical to English 'y' as in 'yellow'" },
      { "letter": "z", "sound_description": "identical to English 'z' as in 'zoo'" }
    ],
    "blends": [
      { "blend": "tsa", "examples": [{ "paiute": "Tsagwudu", "english": "porcupine" }, { "paiute": "Tsapoone", "english": "show" }, { "paiute": "Atsabana", "english": "flicker" }] },
      { "blend": "tse", "examples": [{ "paiute": "Tsemoo", "english": "hip" }, { "paiute": "Tsekwaha", "english": "point" }, { "paiute": "Pabetse", "english": "weasel" }] },
      { "blend": "tso", "examples": [{ "paiute": "Tsopege", "english": "head" }, { "paiute": "Hetsotso'o", "english": "dragonfly" }, { "paiute": "Tawetsogo", "english": "ankle" }] },
      { "blend": "tsu", "examples": [{ "paiute": "Utsu'tsu", "english": "cold" }, { "paiute": "Tatsungu", "english": "count" }, { "paiute": "Yutsunga", "english": "alive" }] },
      { "blend": "tza", "examples": [{ "paiute": "Etza'a", "english": "coyote" }, { "paiute": "Tatza", "english": "summer" }, { "paiute": "Pamagatza'a", "english": "horned toad" }] },
      { "blend": "tze", "examples": [{ "paiute": "Etze'e", "english": "yesterday" }, { "paiute": "Tzepesa", "english": "squirrel" }, { "paiute": "Hootze", "english": "sagehen" }] },
      { "blend": "kwa", "examples": [{ "paiute": "Hukwapu", "english": "wind" }, { "paiute": "Nodukwa", "english": "wife" }, { "paiute": "Togokwa", "english": "snake" }] },
      { "blend": "kwe", "examples": [{ "paiute": "Kwena'a", "english": "eagle" }, { "paiute": "Pakwe", "english": "fish" }, { "paiute": "Kweba", "english": "hit or fall" }] },
      { "blend": "kwo", "examples": [{ "paiute": "Kwo", "english": "hair" }, { "paiute": "Tsakwona", "english": "open" }, { "paiute": "Wokwosakwe'yoo", "english": "eight" }] },
      { "blend": "kwu", "examples": [{ "paiute": "Yukwu", "english": "swallow" }, { "paiute": "Tunekwuhu", "english": "sing" }, { "paiute": "Tsakwuhu", "english": "carry" }] },
      { "blend": "nga", "examples": [{ "paiute": "Pongatze", "english": "mouse" }, { "paiute": "Wanga'a", "english": "younger brother" }, { "paiute": "Yoonga", "english": "carry" }] },
      { "blend": "nge", "examples": [{ "paiute": "Pongeta", "english": "skunk" }, { "paiute": "Wange'e", "english": "fox" }, { "paiute": "Tsawo'nge", "english": "scratch" }] },
      { "blend": "ngo", "examples": [{ "paiute": "Songo'o", "english": "lungs" }, { "paiute": "Yongona", "english": "evening" }, { "paiute": "Pongosa", "english": "arrow" }] },
